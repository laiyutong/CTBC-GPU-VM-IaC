.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# 含密碼或 SSH 金鑰的環境變數檔
environments/**/terraform.tfvars
!environments/**/terraform.tfvars.example

# 連線測試腳本（含真實 RG/VM/密碼）；版控請用 *.txt 範例或複製為 .local.* 後填入
scripts/bash/nsg-connect-test.sh
scripts/bash/public-ip-nsg-connect-test.sh
scripts/bash/*.local.sh
scripts/powershell/nsg-connect-test.ps1
scripts/powershell/public-ip-nsg-connect-test.ps1
scripts/powershell/*.local.ps1

# 本機私鑰（terraform output / 測試用）
keys/
*.pem
